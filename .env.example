# Copy to .env.local (git-ignored) for local development, and set the same
# variable in Vercel → Project → Settings → Environment Variables.

# Google OAuth client ID (type "Web application") for Google Drive backups.
# Not a secret: it is visible in the page. Leave empty to hide the Drive feature.
# See docs/GOOGLE_DRIVE_SETUP.md.
VITE_GOOGLE_CLIENT_ID=
